{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run CLI Demo",
      "type": "shell",
      "command": "C:\\software\\anaconda\\python.exe",
      "args": [
        "research_summary.py",
        "--limit",
        "3",
        "Codex can edit code.",
        "GitHub comments can trigger review."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Unit Tests",
      "type": "shell",
      "command": "C:\\software\\anaconda\\python.exe",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_*.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run Realtime Clock Server",
      "type": "shell",
      "command": "C:\\software\\anaconda\\python.exe",
      "args": [
        "serve_clock.py",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
