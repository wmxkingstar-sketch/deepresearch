{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CLI Demo",
      "type": "debugpy",
      "request": "launch",
      "python": "C:\\software\\anaconda\\python.exe",
      "program": "${workspaceFolder}/research_summary.py",
      "args": [
        "--limit",
        "3",
        "Codex can edit code.",
        "GitHub comments can trigger review."
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "justMyCode": true
    },
    {
      "name": "Debug Current Python File",
      "type": "debugpy",
      "request": "launch",
      "python": "C:\\software\\anaconda\\python.exe",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "justMyCode": true
    },
    {
      "name": "Debug Unit Tests",
      "type": "debugpy",
      "request": "launch",
      "python": "C:\\software\\anaconda\\python.exe",
      "module": "unittest",
      "args": [
        "discover",
        "-s",
        "tests",
        "-p",
        "test_*.py"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "justMyCode": true
    },
    {
      "name": "Run Realtime Clock Server",
      "type": "debugpy",
      "request": "launch",
      "python": "C:\\software\\anaconda\\python.exe",
      "program": "${workspaceFolder}/serve_clock.py",
      "args": [
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
